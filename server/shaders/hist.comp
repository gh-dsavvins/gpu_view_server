#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;

// Passes 1..7: histogram of the current digit over the surviving candidates, per window group.
// Dispatched indirectly with (x, nb, 1) from advance.comp.

shared uint shHist[512];

void main() {
    uint slot = gl_WorkGroupID.y;
    uint lid = gl_LocalInvocationID.x;
    uint count = st[slot * STATE_STRIDE + S_CAND];
    uint src = (pc.srcHalf * pc.slotCap + slot) * pc.cap;

    shHist[lid] = 0u;
    shHist[lid + 256u] = 0u;
    barrier();
    uint stride = gl_NumWorkGroups.x * WG;
    for (uint i = gl_WorkGroupID.x * WG + lid; i < count; i += stride) {
        uint ci = (src + i) * 3u;
        uvec2 k = uvec2(cand[ci], cand[ci + 1u]);
        atomicAdd(shHist[cand[ci + 2u] * 256u + digitOf(k, pc.pass)], 1u);
    }
    barrier();
    uint hb = slot * HIST_STRIDE;
    if (shHist[lid] != 0u) atomicAdd(hist[hb + lid], shHist[lid]);
    if (shHist[lid + 256u] != 0u) atomicAdd(hist[hb + lid + 256u], shHist[lid + 256u]);
}
